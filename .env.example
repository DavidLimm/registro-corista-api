# Copie para .env (ignorado no Git) e ajuste os valores.
# Usado pelo docker compose e pela aplicação no perfil dev.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=registro_coristas
DB_USER=postgres
DB_PASSWORD=postgres

# JWT. Em dev pode ficar sem definir (usa o default do application.yaml). Em prod é obrigatório, com chave própria.
# Gerar: openssl rand -base64 64   (mínimo 32 bytes em Base64)
# JWT_SEGREDO=
# JWT_EXPIRACAO_MINUTOS=60
